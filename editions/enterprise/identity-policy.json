{
  "schema_version": 1,
  "policy_id": "qianlima-enterprise-identity-boundary",
  "purpose": "Keep enterprise identity and any future HTTP promotion behind the Broker.",
  "accepted_identity": ["oidc", "jwt"],
  "issuer_must_be_registered": true,
  "audience_must_match_enterprise_broker": true,
  "signature_and_expiry_required": true,
  "tenant_and_organization_claims_required": true,
  "agent_identity_is_not_user_identity": true,
  "unauthenticated_http": "deny",
  "public_http_listener": "deny",
  "streamable_http": "disabled",
  "future_http_placement": "behind_north_star_broker_only",
  "direct_agent_to_agent": "deny",
  "credential_values_in_prompt_or_grant": "deny",
  "local_development_default": "no_issuer_configured_and_fail_closed"
}
