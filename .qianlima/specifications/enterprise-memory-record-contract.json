{
  "schema_version": 2,
  "contract_id": "beijixing-enterprise-memory-record",
  "contract_version": "2.0.0",
  "purpose": "Keep enterprise memory permission-bound, source-backed, expiring, revocable, and auditable.",
  "required_fields": [
    "memory_id",
    "memory_type",
    "memory_layer",
    "cube_id",
    "content_ref",
    "scope",
    "tenant_id",
    "organization_id",
    "project_id",
    "role_id",
    "classification",
    "record_version",
    "owner_id",
    "audit_chain_ref",
    "source_refs",
    "created_at",
    "updated_at",
    "confidence",
    "expires_at",
    "visibility",
    "status",
    "provenance"
  ],
  "memory_types": ["task", "agent", "organization", "knowledge", "evidence", "audit"],
  "memory_layers": ["trajectory", "strategy", "world_model", "skill"],
  "cube_dimensions": ["tenant_id", "organization_id", "project_id", "role_id"],
  "classifications": ["public", "internal_sanitized", "confidential_reference_only", "restricted_reference_only"],
  "states": ["candidate", "verified", "active", "stale", "superseded", "revoked", "deleted"],
  "visibility": ["task_bound", "agent_bound", "organization_scoped", "authorized_only", "audit_only"],
  "rules": {
    "content_must_be_reference_or_sanitized_summary": true,
    "source_required_before_verified": true,
    "approval_required_for_policy_or_permission_facts": true,
    "conflict_creates_candidate": true,
    "active_never_overwrites_prior_record": true,
    "expired_records_are_not_authoritative": true,
    "revoked_records_are_denied_before_read": true,
    "memory_visibility_does_not_grant_permission": true,
    "memory_learning_cannot_expand_grant": true,
    "read_requires_task_grant_and_scope_match": true,
    "external_agent_receives_sanitized_minimum_pack_only": true,
    "cross_agent_read_requires_revocable_share_grant": true,
    "cross_organization_share_is_denied": true,
    "skill_memory_has_no_execution_authority": true
  },
  "prohibited_content": [
    "secret_value",
    "api_key",
    "token",
    "password",
    "cookie",
    "raw_private_data",
    "raw_customer_data",
    "unverified_permission_claim",
    "hidden_reasoning"
  ],
  "required_provenance_fields": ["event_id", "source_ref", "observed_at", "actor_id", "verification_status"],
  "lifecycle": [
    "candidate",
    "source_and_conflict_check",
    "independent_verification",
    "human_approval_when_required",
    "active",
    "expire_or_supersede",
    "revoke_or_delete_with_audit"
  ]
}
